# What /etc/wickbot.env looks like. Don't edit it by hand: `sudo wickctl configure` writes it (root and the wick user
# can read it, nobody else). Never commit or share the filled-in file.

# CDP Secret API key (ECDSA), restricted to the wickbot portfolio, View + Trade only (no Transfer), IP-allowlisted to
# the server. The key name looks like organizations/<org-id>/apiKeys/<key-id>.
COINBASE_API_KEY="organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# The private key on one line, line breaks written as \n:
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEE...\n-----END EC PRIVATE KEY-----\n"

# Outside heartbeat (healthchecks.io check, period 1 minute): your phone hears about it if the server goes silent.
HEALTHCHECK_URL="https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# The watchdog's alerts (halts, errors, daily line) go to this ntfy topic.
NTFY_TOPIC="wickbot-pick-a-long-random-name"

# Live switch: the bot refuses to place real orders unless this says yes.
I_UNDERSTAND_LIVE_TRADING=no
