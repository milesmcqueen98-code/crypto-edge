# Copy to /etc/wickbot.env on the server (setup_vm.sh does), then fill in and `sudo chmod 600 /etc/wickbot.env`.
# Never commit the filled-in file.

# CDP Secret API key (ECDSA), restricted to the bot's portfolio, View + Trade only (no Transfer), IP-allowlisted to
# this server. The key name looks like organizations/<org-id>/apiKeys/<key-id>.
COINBASE_API_KEY="organizations/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/apiKeys/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# The private key on one line, with the line breaks written as \n:
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEE...\n-----END EC PRIVATE KEY-----\n"

# Live switch: the bot refuses to place real orders without it.
I_UNDERSTAND_LIVE_TRADING=yes

# Optional phone alerts from watchdog.py via ntfy.sh: install the ntfy app and subscribe to this (hard-to-guess) topic.
NTFY_TOPIC=""
